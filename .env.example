# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=TaskFlow
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@db:5432/taskflow

# Test DB (used by pytest)
TEST_DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Access token TTL in minutes (15 min recommended)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token TTL in days (30 days)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ─── App Port ─────────────────────────────────────────────────────────────────
APP_PORT=8000

# ─── Telegram (optional) ─────────────────────────────────────────────────────
# Leave empty to disable Telegram notifications
TELEGRAM_BOT_TOKEN=
